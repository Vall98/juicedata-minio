{
  "presets": [
    [
      "@babel/preset-env",
      {
        "useBuiltIns": "entry",
        "corejs": 3
      }
    ],
    [
      "@babel/preset-react",
      {
        "runtime": "classic" // change to automatic when upgrading react.
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-object-rest-spread"
  ]
}