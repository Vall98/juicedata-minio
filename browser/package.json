{
  "name": "browser",
  "version": "0.0.1",
  "description": "MinIO Browser",
  "scripts": {
    "test": "jest",
    "dev": "NODE_ENV=dev webpack serve --config webpack.config.js --mode development --devtool eval-cheap-module-source-map --progress --hot",
    "build": "NODE_ENV=dev node build.js",
    "release": "NODE_ENV=production node build.js",
    "format": "esformatter -i 'app/**/*.js'"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/app/js/jest/setup.js"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "https://localhost:8080"
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/app/js/jest/__mocks__/fileMock.js",
      "\\.(css|scss)$": "identity-obj-proxy"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minio/minio"
  },
  "author": "MinIO Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/minio/minio/issues"
  },
  "homepage": "https://github.com/minio/minio",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/react": "^12.1.5",
    "async": "^3.2.0",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.4.1",
    "cheerio": "^1.0.0-rc.10",
    "copy-webpack-plugin": "^6.0.1",
    "css-loader": "^7.1.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.2",
    "esformatter": "^0.8.2",
    "esformatter-jsx": "^7.2.0",
    "esformatter-jsx-ignore": "^1.0.6",
    "html-webpack-plugin": "^4.3.0",
    "jest": "^26.6.3",
    "jest-environment-jsdom": "^26.6.2",
    "jest-enzyme": "^4.2.0",
    "json-loader": "^0.5.7",
    "less": "^3.11.1",
    "less-loader": "^10.2.0",
    "purgecss-webpack-plugin": "^7.0.2",
    "style-loader": "^3.3.4",
    "url-loader": "^4.1.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.13.0",
    "bootstrap": "^3.4.1",
    "classnames": "^2.2.6",
    "core-js": "^3.6.5",
    "expect": "^26.0.1",
    "glob-all": "^3.2.1",
    "history": "^4.10.1",
    "humanize": "0.0.9",
    "identity-obj-proxy": "^3.0.0",
    "jwt-decode": "^2.2.0",
    "local-storage-fallback": "^4.1.1",
    "material-design-iconic-font": "^2.2.0",
    "mime-db": "^1.44.0",
    "mime-types": "^2.1.27",
    "moment": "^2.26.0",
    "path-browserify": "^1.0.1",
    "query-string": "^6.12.1",
    "react": "^16.13.1",
    "react-bootstrap": "^0.33.1",
    "react-copy-to-clipboard": "^5.0.2",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "^16.13.1",
    "react-dropzone": "^11.0.1",
    "react-infinite-scroller": "^1.2.4",
    "react-onclickout": "^2.0.8",
    "react-qr-code": "^1.1.1",
    "react-redux": "^5.1.2",
    "react-router-dom": "^5.2.0",
    "redux": "^4.0.5",
    "redux-mock-store": "^1.5.4",
    "redux-thunk": "^2.3.0",
    "reselect": "^4.0.0",
    "superagent": "^5.2.2",
    "superagent-es6-promise": "^1.0.0"
  }
}
